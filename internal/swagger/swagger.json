            "name": "date",
            "in": "query",
            "required": true,
            "schema": { "type": "string", "example": "2026-03-31" }
          },
          {
            "name": "barbershop_service_id",
            "in": "query",
            "required": true,
            "schema": { "type": "integer", "format": "int64" }
          },
          {
            "name": "start_time",
            "in": "query",
            "required": false,
            "schema": { "type": "string", "example": "09:00:00" }
          },
          {
            "name": "end_time",
            "in": "query",
            "required": false,
